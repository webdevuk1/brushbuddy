{
  "manifest_version": 3,
  "name": "BrushBuddy",
  "version": "0.3.8",
  "description": "Your little buddy pops up when it's time to brush your teeth.",
  "key": "",
  "minimum_chrome_version": "109",
  "offline_enabled": true,
  "permissions": ["alarms", "storage", "notifications", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webdevuk1.github.io/brushbuddy/*",
        "https://brushbuddy-roan.vercel.app/*"
      ],
      "js": ["content/site-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "BrushBuddy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/library/thumbs/128/brushing.png",
        "assets/library/thumbs/128/closeup.png",
        "assets/library/thumbs/128/night.png",
        "assets/library/thumbs/128/morning.png",
        "assets/library/thumbs/128/wink.png",
        "assets/sounds/alert.mp3"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
