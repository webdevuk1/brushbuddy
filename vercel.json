{
  "buildCommand": "",
  "outputDirectory": "docs",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin/go-live", "destination": "/admin/go-live.html" },
    { "source": "/admin", "destination": "/admin/go-live.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
